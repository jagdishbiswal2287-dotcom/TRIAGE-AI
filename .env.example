# TRIAGE-AI Environment Configuration
# Copy this file to .env for local adjustments

APP_NAME=TRIAGE-AI
APP_ENV=development
PORT=8000
HOST=127.0.0.1

# Database Configuration (Defaults to local SQLite)
# To switch to PostgreSQL later:
# DATABASE_URL=postgresql://user:password@localhost:5432/triage_ai
DATABASE_URL=sqlite:///./triage.db

# Optional AI / LLM Configuration (Default is modular local rule-engine, 0 API keys required)
# AI_PROVIDER=gemini
# GEMINI_ENABLED=false
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# OCR & Speech Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
